{
  "schema": "dezign0/eval-task/v1",
  "id": "dashboard-01",
  "profile": "dashboard",
  "title": "Support queue dashboard",
  "artifact": "index.html",
  "a11y": true,
  "interactive": true,
  "motion": true,
  "structure": { "minBytes": 4000 },
  "mustHave": [
    { "id": "main", "pattern": "<main[\\s>]", "description": "Main landmark" },
    { "id": "h1", "pattern": "<h1[\\s>]", "description": "Page heading" },
    { "id": "table", "pattern": "<table[\\s>]", "description": "Ticket data table" },
    { "id": "caption", "pattern": "<caption[\\s>]", "description": "Table caption" },
    { "id": "th-scope", "pattern": "<th[^>]*scope\\s*=", "description": "Scoped column headers" },
    { "id": "search", "pattern": "type\\s*=\\s*[\"']search[\"']", "description": "Search filter input" },
    { "id": "empty", "pattern": "id\\s*=\\s*[\"']empty-state[\"']", "description": "Separate empty state" },
    { "id": "live", "pattern": "aria-live\\s*=", "description": "Live summary region" },
    { "id": "focus", "pattern": ":focus-visible", "description": "Visible keyboard focus" },
    { "id": "reduced", "pattern": "prefers-reduced-motion", "description": "Reduced-motion handling" }
  ],
  "forbidden": [
    { "id": "placeholder", "pattern": "lorem ipsum|your (?:text|content) here", "description": "No placeholder copy" },
    { "id": "uptime", "pattern": "99(?:\\.9+)?%\\s*uptime", "description": "No invented uptime figure" },
    { "id": "deadlinks", "pattern": "href\\s*=\\s*[\"']#[\"']", "description": "No dead links" },
    { "id": "todos", "pattern": "\\bTODO\\b|\\bFIXME\\b", "description": "No unfinished markers" }
  ]
}

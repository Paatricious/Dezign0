{
  "schema": "dezign0/eval-task/v1",
  "id": "document-01",
  "profile": "document",
  "title": "Incident postmortem report",
  "artifact": "report.html",
  "a11y": true,
  "interactive": false,
  "motion": false,
  "structure": { "minBytes": 5000 },
  "mustHave": [
    { "id": "main", "pattern": "<main[\\s>]", "description": "Main landmark" },
    { "id": "h1", "pattern": "<h1[\\s>]", "description": "Report title" },
    { "id": "toc", "pattern": "<nav[\\s>]", "description": "Table of contents nav" },
    { "id": "sections", "pattern": "<h2[\\s>]", "min": 5, "description": "At least five report sections" },
    { "id": "table", "pattern": "<table[\\s>]", "min": 2, "description": "Timeline and action-item tables" },
    { "id": "caption", "pattern": "<caption[\\s>]", "description": "Table captions" },
    { "id": "time", "pattern": "<time[^>]*datetime\\s*=", "description": "Machine-readable timestamps" },
    { "id": "sources", "pattern": "id\\s*=\\s*[\"']sources[\"']", "description": "Sources section" },
    { "id": "print", "pattern": "@media\\s+print", "description": "Print stylesheet" },
    { "id": "measure", "pattern": "max-width\\s*:\\s*\\d+ch", "description": "Readable 50-75ch measure" }
  ],
  "forbidden": [
    { "id": "placeholder", "pattern": "lorem ipsum|your (?:text|content) here", "description": "No placeholder copy" },
    { "id": "todos", "pattern": "\\bTODO\\b|\\bFIXME\\b", "description": "No unfinished markers" },
    { "id": "invented", "pattern": "\\b\\d{1,3}(?:\\.\\d+)?%\\s*(?:uptime|faster|more reliable)", "description": "No invented percentages" },
    { "id": "deadlinks", "pattern": "href\\s*=\\s*[\"']#[\"']", "description": "No dead links" }
  ]
}
